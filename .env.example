TOKEN=your_bot_token_here

# Prefix for classic (non-slash) commands
PREFIX=,

# --- Web dashboard ---
# Set to true to launch the dashboard alongside the bot process.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
# Set to true only if you're running behind HTTPS (reverse proxy/tunnel).
DASHBOARD_FORCE_HTTPS=false
# Run `python set_dashboard_password.py` to fill these in automatically -
# do not hand-edit DASHBOARD_PASSWORD_HASH.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=

# --- Optional: /ask AI chat command (cogs/ai_chat.py) ---
# Works with OpenAI or any OpenAI-compatible API (Groq, OpenRouter, local servers, etc).
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Optional: Twitch live notifications (cogs/social_feeds.py) ---
# YouTube upload notifications work with no keys needed (public RSS feed).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
